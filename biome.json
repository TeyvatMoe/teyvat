{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"files": {
		"includes": [
			"**",
			"!!dist",
			"!!docs",
			"!!**/*.js",
			"!!.direnv",
			"!!node_modules",
			"!!.tmp",
			"!!tests/results",
			"!!tsdown.config.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 120,
		"indentWidth": 4,
		"indentStyle": "tab"
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",

			"suspicious": {
				"noAssignInExpressions": "off"
			},

			"correctness": {
				"noUnusedImports": {
					"level": "warn",
					"fix": "safe"
				},
				"noUnusedVariables": {
					"level": "warn",
					"fix": "safe"
				},
				"useImportExtensions": "error",
				"noUndeclaredDependencies": "error"
			},

			"complexity": {
				"noExcessiveCognitiveComplexity": "warn"
			},

			"performance": {
				"noReExportAll": "error"
			},

			"style": {
				"noParameterAssign": "off",
				"useExportType": "error",

				"noDefaultExport": "error",
				"noNamespace": "error",
				"useConsistentArrayType": "error",
				"useNamingConvention": "error",
				"useFilenamingConvention": "error"
			}
		}
	}
}
