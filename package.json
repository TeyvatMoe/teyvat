{
	"name": "teyvat",
	"version": "1.2.0",
	"description": "A type-safe TypeScript library for exploring your Genshin Impact account.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=20",
		"bun": ">=1.2"
	},
	"keywords": [
		"genshin-impact",
		"hoyolab",
		"typescript",
		"api-client"
	],
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build:lib": "tsdown",
		"build:docs": "typedoc --options typedoc.json",
		"build": "bun build:lib && bun build:docs",
		"check": "biome check",
		"dev": "bun ./tests/index.ts",
		"prepublishOnly": "bun check && bun test && bunx tsc --noEmit && bun build:lib"
	},
	"devDependencies": {
		"@types/bun": "1.3.13",
		"arkenv": "0.12.3",
		"bun.db": "1.1.5",
		"elysia": "1.4.29",
		"tsdown": "0.21.10",
		"typedoc-github-theme": "0.4.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"typescript": "~6.0.0"
	},
	"dependencies": {
		"arktype": "2.2.3",
		"cookie": "2.0.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TeyvatMoe/teyvat.git"
	},
	"bugs": {
		"url": "https://github.com/TeyvatMoe/teyvat/issues"
	},
	"homepage": "https://lib.teyvat.moe"
}
