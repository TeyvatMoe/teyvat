{
	"name": "teyvat",
	"version": "1.0.0",
	"description": "A type-safe TypeScript library for exploring your Genshin Impact account.",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build:lib": "tsdown",
		"build:docs": "typedoc --options typedoc.json",
		"build": "bun build:lib && bun build:docs",
		"check": "biome check",
		"dev": "bun ./tests/index.ts"
	},
	"devDependencies": {
		"@types/bun": "1.3.13",
		"arkenv": "0.12.3",
		"bun.db": "1.1.5",
		"elysia": "1.4.29",
		"tsdown": "0.21.10",
		"typedoc-github-theme": "0.4.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"typescript": "~6.0.0"
	},
	"dependencies": {
		"arktype": "2.2.3"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/TeyvatMoe/teyvat.git"
	},
	"bugs": {
		"url": "https://github.com/TeyvatMoe/teyvat/issues"
	},
	"homepage": "https://lib.teyvat.moe"
}
